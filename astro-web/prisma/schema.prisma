// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Category {
  MONTHLY   // Aylık Yorum
  RETRO     // Retro Rehberi
  TIP       // Ritüel/İpucu
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  role  String  @default("user")
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     Json     // tipografya-rich text (TipTap/Editor.js)
  coverImage  String?  // CDN veya /uploads
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  category    Category @default(MONTHLY)  // ⬅︎ yeni alan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  date        DateTime
  type        String
  description String
}

model Reel {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String
  thumbnail   String
  publishedAt DateTime @default(now())
  calendarUrl String?  // iCal link (opsiyonel)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Horoscope {
  id          Int      @id @default(autoincrement())
  sign        String
  period      String
  content     Json
  publishedAt DateTime

  @@unique([sign, period])
}

model Consultation {
  id         String   @id @default(cuid())
  name       String
  email      String
  birthDate  DateTime
  birthPlace String
  question   String
  createdAt  DateTime @default(now())
}

model Comment {
  id            Int      @id @default(autoincrement())
  name          String
  email         String
  content       String
  isApproved    Boolean  @default(false)
  isHighlighted Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  keys      String   // JSON string of p256dh and auth keys
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
